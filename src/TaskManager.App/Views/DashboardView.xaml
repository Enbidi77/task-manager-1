<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TaskManager.Application.ViewModels;assembly=TaskManager.Application"
             x:Class="TaskManager.App.Views.DashboardView"
             x:DataType="viewmodels:DashboardViewModel">

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="16">
            <!-- Greeting -->
            <Label Text="{Binding Greeting}" Style="{StaticResource PageTitle}" />
            
            <!-- Stat Cards -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Today's Tasks" Style="{StaticResource Subtitle}" />
                        <Label Text="{Binding TodayTasksCount}" FontSize="32" FontAttributes="Bold" TextColor="{DynamicResource AccentColor}" />
                    </VerticalStackLayout>
                </Border>
                
                <Border Grid.Column="1" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Completed" Style="{StaticResource Subtitle}" />
                        <Label Text="{Binding CompletedTodayCount}" FontSize="32" FontAttributes="Bold" TextColor="{DynamicResource SuccessColor}" />
                    </VerticalStackLayout>
                </Border>
                
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Focus Time" Style="{StaticResource Subtitle}" />
                        <Label Text="{Binding FocusTimeStr}" FontSize="32" FontAttributes="Bold" TextColor="{DynamicResource WarningColor}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            
            <!-- Progress Bar -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Today's Progress" FontAttributes="Bold" />
                        <Label Text="{Binding ProgressPercentage, StringFormat='{0}%'}" TextColor="{DynamicResource TextSecondaryColor}" />
                    </HorizontalStackLayout>
                    <ProgressBar Progress="{Binding ProgressValue}" ProgressColor="{DynamicResource AccentColor}" />
                </VerticalStackLayout>
            </Border>
            
            <!-- Bottom Sections -->
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="16">
                <!-- Tasks List -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Today's Tasks" FontAttributes="Bold" FontSize="18" />
                        <CollectionView ItemsSource="{Binding TodayTasks}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" />
                                        <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center" Margin="8,0" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                
                <!-- Recent Activity -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Recent Activity" FontAttributes="Bold" FontSize="18" />
                        <CollectionView ItemsSource="{Binding RecentActivities}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <HorizontalStackLayout Spacing="8" Padding="0,8">
                                        <Label Text="•" TextColor="{DynamicResource AccentColor}" />
                                        <Label Text="{Binding Description}" />
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
