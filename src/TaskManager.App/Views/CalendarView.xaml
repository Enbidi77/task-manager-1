<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TaskManager.Application.ViewModels;assembly=TaskManager.Application"
             xmlns:converters="clr-namespace:TaskManager.App.Converters"
             xmlns:entities="clr-namespace:TaskManager.Core.Entities;assembly=TaskManager.Core"
             x:Class="TaskManager.App.Views.CalendarView"
             x:DataType="viewmodels:CalendarViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:PriorityToColorConverter x:Key="PriorityToColorConverter" />
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="16">
        <!-- Calendar Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" BackgroundColor="{DynamicResource SurfaceColor}" StrokeShape="RoundRectangle 8" Padding="16">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                    <Button Text="◀" Command="{Binding NavigateBackwardCommand}" WidthRequest="36" HeightRequest="36" Padding="0" BackgroundColor="{DynamicResource BackgroundColor}" TextColor="{DynamicResource TextPrimaryColor}" />
                    <Button Text="Today" Command="{Binding TodayCommand}" BackgroundColor="{DynamicResource BackgroundColor}" TextColor="{DynamicResource TextPrimaryColor}" Padding="12,6" />
                    <Button Text="▶" Command="{Binding NavigateForwardCommand}" WidthRequest="36" HeightRequest="36" Padding="0" BackgroundColor="{DynamicResource BackgroundColor}" TextColor="{DynamicResource TextPrimaryColor}" />
                    <Label Text="{Binding CurrentDate, StringFormat='{0:MMMM yyyy}'}" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" TextColor="{DynamicResource TextPrimaryColor}" Margin="8,0,0,0" />
                </HorizontalStackLayout>

                <Button Grid.Column="2" Text="🔄 Refresh" Clicked="OnRefreshClicked" />
            </Grid>
        </Border>

        <!-- Scheduled Tasks List -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" BackgroundColor="{DynamicResource SurfaceColor}" StrokeShape="RoundRectangle 8" Padding="20">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <Label Grid.Row="0" Text="Scheduled Milestones &amp; Deadlines" FontAttributes="Bold" FontSize="16" TextColor="{DynamicResource TextPrimaryColor}" />

                <CollectionView Grid.Row="1" ItemsSource="{Binding CalendarItems}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:TaskItem">
                            <Border Margin="0,4" Style="{StaticResource CardBorder}" BackgroundColor="{DynamicResource BackgroundColor}" StrokeShape="RoundRectangle 6" Padding="14">
                                <Grid ColumnDefinitions="140,*,Auto,Auto" ColumnSpacing="16" VerticalOptions="Center">
                                    <Border Grid.Column="0" BackgroundColor="{DynamicResource CardBackgroundColor}" StrokeShape="RoundRectangle 4" Padding="8,4">
                                        <Label Text="{Binding DueDate, StringFormat='📅 {0:MMM dd, yyyy}'}" FontAttributes="Bold" FontSize="12" TextColor="{DynamicResource AccentColor}" VerticalOptions="Center" />
                                    </Border>

                                    <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="Center" />

                                    <Border Grid.Column="2" BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" StrokeShape="RoundRectangle 4" Padding="8,2">
                                        <Label Text="{Binding Status}" FontSize="11" TextColor="White" FontAttributes="Bold" />
                                    </Border>

                                    <Border Grid.Column="3" BackgroundColor="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}" StrokeShape="RoundRectangle 4" Padding="8,2">
                                        <Label Text="{Binding Priority}" FontSize="11" TextColor="White" FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>

</ContentView>
