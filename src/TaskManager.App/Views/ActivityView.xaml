<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TaskManager.Application.ViewModels;assembly=TaskManager.Application"
             xmlns:converters="clr-namespace:TaskManager.App.Converters"
             xmlns:entities="clr-namespace:TaskManager.Core.Entities;assembly=TaskManager.Core"
             x:Class="TaskManager.App.Views.ActivityView"
             x:DataType="viewmodels:ActivityViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:DateTimeToRelativeConverter x:Key="DateTimeToRelativeConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="16">
            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="📜 Activity Timeline &amp; Audit Trail" Style="{StaticResource PageTitle}" />
                    <Label Text="Real-time log of team actions, status updates, and milestone progression" Style="{StaticResource Subtitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="🔄 Refresh" Command="{Binding LoadMoreCommand}" />
            </Grid>

            <!-- Activity List -->
            <Border Style="{StaticResource CardBorder}" BackgroundColor="{DynamicResource SurfaceColor}" StrokeShape="RoundRectangle 8" Padding="20">
                <CollectionView ItemsSource="{Binding Activities}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:Activity">
                            <Border Margin="0,4" Style="{StaticResource CardBorder}" BackgroundColor="{DynamicResource BackgroundColor}" StrokeShape="RoundRectangle 6" Padding="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                                    <Border Grid.Column="0" BackgroundColor="{DynamicResource AccentLightColor}" StrokeShape="RoundRectangle 6" Padding="8,4">
                                        <Label Text="{Binding Type}" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource AccentColor}" />
                                    </Border>

                                    <Label Grid.Column="1" Text="{Binding Description}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="13" VerticalOptions="Center" />

                                    <Label Grid.Column="2" Text="{Binding CreatedAt, Converter={StaticResource DateTimeToRelativeConverter}}" FontSize="11" TextColor="{DynamicResource TextTertiaryColor}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentView>
